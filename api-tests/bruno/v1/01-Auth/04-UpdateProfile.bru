meta {
  name: 04-UpdateProfile
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Super Admin Updated",
    "locale": "id",
    "timezone": "Asia/Jakarta",
    "theme": "dark"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has updated profile data", function() {
    const body = res.getBody();
    expect(body.data).to.be.an('object');
    expect(body.data.name).to.equal("Super Admin Updated");
    expect(body.data.locale).to.equal("id");
    expect(body.data.theme).to.equal("dark");
  });
}
