meta {
  name: Update Post
  type: http
  seq: 4
}

put {
  url: {{base_url}}/posts/{{created_post_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Updated Post from Bruno"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has updated title", function() {
    const body = res.getBody();
    const data = body.data;
    expect(data.title).to.equal("Updated Post from Bruno");
  });
}
