meta {
  name: List Users
  type: http
  seq: 4
}

get {
  url: {{base_url}}/users
  body: none
  auth: inherit
}

params:query {
  ~per_page: 15
  ~pagination: cursor
  ~page: 1
}

headers {
  Authorization: Bearer {{access_token}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has user list", function() {
    const body = res.getBody();
    const data = body.data;
    expect(data).to.be.an('array');
    if (data.length > 0) {
      bru.setVar("last_user_id", data[0].id);
    }
  });

  test("Response has pagination meta", function() {
    const body = res.getBody();
    expect(body.meta).to.be.an('object');
  });
}
