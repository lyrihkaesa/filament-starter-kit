meta {
  name: Create User
  type: http
  seq: 5
}

post {
  url: {{base_url}}/users
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "Test User",
    "email": "testuser-{{$randomInt}}@example.com",
    "password": "password",
    "roles": ["super_admin"]
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response has user data", function() {
    const body = res.getBody();
    const data = body.data;
    expect(data.id).to.be.a('string');
    bru.setVar("created_user_id", data.id);
  });
}
