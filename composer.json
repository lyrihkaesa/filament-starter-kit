{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lyrihkaesa/filament-starter-kit",
    "type": "project",
    "description": "Filament Starter Kit for Laravel with best practices",
    "keywords": [
        "laravel",
        "framework",
        "filament",
        "starter kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "awcodes/filament-curator": "^5.0",
        "bezhansalleh/filament-shield": "^4.0",
        "dedoc/scramble": "^0.13.43",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/head": "^0.2.2",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/livewire": "^4.2",
        "matomo/device-detector": "^6.5",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-backup": "^10.2",
        "stechstudio/filament-impersonate": "^5.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.2",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.3",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --graceful --ansi",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": "pint",
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:typos": "peck",
        "test:lint": "pint --test",
        "test:unit": "php -d xdebug.mode=coverage ./vendor/bin/pest --coverage",
        "test:unit:parallel": "php -d xdebug.mode=coverage ./vendor/bin/pest --parallel --coverage",
        "test:unit100": "php -d xdebug.mode=coverage ./vendor/bin/pest --coverage --exactly=100",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test-full": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel --compact",
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:refactor"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel --compact",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:refactor"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
