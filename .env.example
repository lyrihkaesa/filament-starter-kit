BACKUP_VERIFY=false
BACKUP_SCHEDULE_FREQUENCY=daily
BACKUP_SCHEDULE_TIME=01:00
BACKUP_SCHEDULE_WEEKLY_DAY=1
BACKUP_SCHEDULE_MONTHLY_DAY=1
BACKUP_CLEANUP_TIME=01:30
BACKUP_MONITOR_TIME=06:00
